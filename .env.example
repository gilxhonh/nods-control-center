# Copy to .env and fill in. Never commit real credentials.

# Our own database (assignments, baselines, blocks, deliveries, audit log)
DATABASE_URL=postgres://ncc:ncc@localhost:5432/ncc

# Existing master request database (read-only user)
SOURCE_DATABASE_URL=postgres://readonly_user:password@host:5432/master_requests

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Company sign-in (OIDC)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Integrations (read-only where possible)
MOZENDA_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
